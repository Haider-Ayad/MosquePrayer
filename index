// متغيرات لحفظ الحالة الحالية والتأكد من عدم التكرار السريع
let currentQuranIndex = -1, currentHadithIndex = -1, currentDhikrIndex = -1;
let prevQuranIndex = -1, prevHadithIndex = -1, prevDhikrIndex = -1;

function getRandomItem(arr, lastIndex) {
  let newIdx;
  // التأكد من أن العنصر الجديد ليس نفس العنصر السابق
  do {
    newIdx = Math.floor(Math.random() * arr.length);
  } while (newIdx === lastIndex);
  return newIdx;
}

function rotateSpiritual() {
  // دالة خاصة لتغيير النص مع تأثير Fade In/Out سلس
  const updateWithFade = (elementId, sourceId, dataArray, currentIdxVarName) => {
    const textEl = $(elementId);
    const sourceEl = $(sourceId);
    const data = dataArray;
    const currentIdx = state[currentIdxVarName] || -1;

    // 1. اختفاء النص الحالي
    textEl.style.opacity = '0';
    textEl.style.transform = 'translateY(5px)';
    sourceEl.style.opacity = '0';

    // 2. بعد انتهاء الاختفاء، تغيير النص وإعادته للظهور
    setTimeout(() => {
      const newIdx = getRandomItem(data, currentIdx);
      state[currentIdxVarName] = newIdx; // حفظ الرقم الجديد في الـ State

      textEl.textContent = data[newIdx].text;
      sourceEl.textContent = data[newIdx].source;

      textEl.style.opacity = '1';
      textEl.style.transform = 'translateY(0)';
      sourceEl.style.opacity = '1';
    }, 800); // 800 ملي ثانية تعادل وقت الـ transition في CSS
  };

  updateWithFade('quranText', 'quranSource', spiritualData.quran, 'currentQuranIndex');
  updateWithFade('hadithText', 'hadithSource', spiritualData.hadith, 'currentHadithIndex');
  updateWithFade('dhikrText', 'dhikrSource', spiritualData.dhikr, 'currentDhikrIndex');
}

