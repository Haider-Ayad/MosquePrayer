<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#09281e">
<title>شاشة جامع الرحمن</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style>
/* Global Reset & Dark Theme */
:root {
  --bg-main: #0e231c;
  --bg-panel: #0b2a20;
  --gold: #e2bc63;
  --gold-light: #f5d98f;
  --cream: #faf3e6;
  --text-muted: #adb5bd;
  --border-color: rgba(226, 188, 99, 0.3);
}

* { box-sizing: border-box; }
html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; }
body {
  font-family: 'Cairo', Tahoma, Arial, sans-serif;
  color: var(--cream);
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  background: #04120d; 
  position: relative;
}

/* === خلفية الصور الإسلامية المتغيرة بشكل سلس === */
.slideshow-bg {
  position: fixed;
  inset: 0;
  z-index: -2;
  background-size: cover;
  background-position: center;
  animation: slideShow 24s infinite alternate ease-in-out;
}
@keyframes slideShow {
  0% { background-image: url('https://images.unsplash.com/photo-1541151047410-eb4729b9a5f0?q=80&w=1920&auto=format&fit=crop'); opacity: 1; }
  25% { background-image: url('https://images.unsplash.com/photo-1579759778113-6d4c768ca69c?q=80&w=1920&auto=format&fit=crop'); opacity: 1; }
  50% { background-image: url('https://images.unsplash.com/photo-1591825729269-c5327033e1f9?q=80&w=1920&auto=format&fit=crop'); opacity: 1; }
  75% { background-image: url('https://images.unsplash.com/photo-1566592218203-2bb7a02e312b?q=80&w=1920&auto=format&fit=crop'); opacity: 1; }
  100% { background-image: url('https://images.unsplash.com/photo-1593520296718-18d5b4f8af09?q=80&w=1920&auto=format&fit=crop'); opacity: 1; }
}
.overlay-layer {
  position: fixed;
  inset: 0;
  z-index: -1;
  background: rgba(0, 15, 10, 0.65);
  backdrop-filter: blur(2px);
}

/* === تخطيط الشبكة الرئيسي === */
.app {
  width: 98vw;
  height: 97vh;
  display: grid;
  grid-template-columns: 25% 52% 23%;
  grid-template-rows: 12% 1fr 18%; /* زيادة ارتفاع الفوتر قليلاً */
  gap: 12px;
  padding: 10px;
  opacity: 0;
  transform: translateY(15px);
  animation: fadeInUp 0.8s cubic-bezier(0.165, 0.84, 0.44, 1) forwards;
}
@keyframes fadeInUp { to { opacity: 1; transform: translateY(0); } }

/* حركة ناعمة للعناصر الداخلية */
.panel, .prayer-item, .countdown-box, .footer-item { transition: all 0.3s ease-in-out; }
.prayer-item:hover { transform: scale(1.02); border-color: var(--gold-light); }

/* === رأس الصفحة (Header) === */
.header {
  grid-column: 1 / -1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 20px;
  background: rgba(11, 42, 32, 0.85);
  border: 1px solid var(--border-color);
  border-radius: 15px;
  box-shadow: inset 0 0 20px rgba(0,0,0,0.5);
  backdrop-filter: blur(5px);
}
.header-left { display: flex; align-items: center; gap: 15px; }
.header-left .icon { font-size: 3.5rem; }
.header-left h1 {
  font-family: 'Amiri', serif;
  font-size: 2.5rem;
  margin: 0;
  color: var(--gold);
  text-shadow: 0 0 10px rgba(226, 188, 99, 0.3);
}
.header-left .subtitle { font-size: 0.8rem; color: var(--text-muted); margin-top: -5px; display: block; }

.header-center { text-align: center; }
.header-center .hijri { font-size: 1.8rem; font-family: 'Amiri', serif; color: var(--cream); font-weight: bold; }
.header-center .greg { font-size: 1rem; color: var(--text-muted); }

.header-right { font-size: 3.5rem; font-weight: 900; color: var(--cream); font-variant-numeric: tabular-nums; letter-spacing: 2px; }

/* === العمود الأيسر (الساعة الدائرية فقط) === */
.col-left { grid-column: 1; display: flex; flex-direction: column; gap: 12px; }
.panel {
  background: rgba(11, 42, 32, 0.85);
  backdrop-filter: blur(5px);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 15px;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4px 15px rgba(0,0,0,0.4);
}
.clock-box { flex: 1.5; align-items: center; justify-content: center; text-align: center; position: relative; }
.clock-box .analog {
  width: 250px; height: 250px;
  border-radius: 50%;
  border: 10px solid var(--gold);
  background: radial-gradient(circle, rgba(28, 59, 46, 0.9), rgba(10, 31, 23, 0.95));
  margin: 0 auto;
  position: relative;
  box-shadow: 0 0 40px rgba(226, 188, 99, 0.15);
}
.clock-box .analog .hand {
  position: absolute; bottom: 50%; left: 50%; transform-origin: bottom center;
  border-radius: 10px; background: var(--gold);
  transition: transform 0.5s cubic-bezier(0.4, 2.08, 0.55, 0.44);
}
.hand-hour { width: 8px; height: 70px; margin-left: -4px; }
.hand-minute { width: 6px; height: 100px; margin-left: -3px; background: var(--cream); }
.hand-second { width: 3px; height: 110px; margin-left: -1.5px; background: #e74c3c; }
.center-dot { width: 16px; height: 16px; background: var(--gold); border-radius: 50%; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); }
.sun-times { display: flex; justify-content: space-between; font-size: 0.9rem; border-top: 1px solid var(--border-color); padding-top: 15px; margin-top: 15px; }
.sun-times div { display: flex; align-items: center; gap: 8px; }

/* === العمود الأوسط === */
.col-center { grid-column: 2; display: flex; flex-direction: column; gap: 12px; }
.prayers-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(2, 1fr);
  gap: 10px;
  flex: 1;
}
.prayer-item {
  background: rgba(13, 44, 34, 0.6);
  border: 1px solid #163a2d;
  border-radius: 10px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  position: relative;
  padding: 5px;
}
.prayer-item.active {
  border-color: var(--gold);
  background: linear-gradient(135deg, rgba(28, 68, 47, 0.8), rgba(13, 44, 34, 0.9));
  box-shadow: 0 0 15px rgba(226, 188, 99, 0.2);
}
.prayer-item.active::after {
  content: "الصلاة الحالية";
  position: absolute;
  bottom: -10px;
  background: var(--gold);
  color: #000;
  font-size: 0.7rem;
  font-weight: bold;
  padding: 2px 10px;
  border-radius: 20px;
}
.prayer-item .icon { font-size: 1.8rem; }
.prayer-item .name { font-size: 1.2rem; font-weight: bold; margin-top: 5px; }
.prayer-item .time { font-size: 1.8rem; font-weight: 900; color: var(--cream); margin-top: 5px; }
.prayer-item .period { font-size: 0.9rem; color: var(--text-muted); }
.prayer-item.active .name, .prayer-item.active .time { color: var(--gold); }

.countdown-box {
  background: rgba(13, 44, 34, 0.7);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 10px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80px;
}
.countdown-box .left { display: flex; align-items: center; gap: 15px; }
.countdown-box .left .icon { font-size: 2.5rem; }
.countdown-box .left .text { display: flex; flex-direction: column; }
.countdown-box .left .text span:first-child { font-size: 1rem; color: var(--text-muted); }
.countdown-box .left .text span:last-child { font-size: 2rem; font-weight: bold; color: var(--gold); }
.countdown-box .timer { font-size: 2.5rem; font-weight: 900; color: #4ade80; font-variant-numeric: tabular-nums; direction: ltr; }

/* === العمود الأيمن === */
.col-right { grid-column: 3; display: flex; flex-direction: column; gap: 12px; }
.weather-box { flex: 2; text-align: center; }
.weather-box .title { text-align: right; font-size: 1rem; margin-bottom: 15px; display: flex; gap: 10px; align-items: center; }
.weather-box .main { display: flex; justify-content: space-around; align-items: center; margin: 10px 0; }
.weather-box .main .temp { font-size: 4rem; font-weight: 900; }
.weather-box .main .icon { font-size: 5rem; }
.weather-box .main .desc { font-size: 1.2rem; color: var(--text-muted); margin-top: -10px; }
.weather-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-top: 20px;
}
.weather-stats .stat { background: rgba(255,255,255,0.05); padding: 10px; border-radius: 8px; display: flex; justify-content: space-between; align-items: center; }
.weather-stats .stat span { color: var(--text-muted); font-size: 0.9rem; }
.weather-stats .stat b { font-size: 1.1rem; }
.location-box { flex: 1; align-items: center; justify-content: center; text-align: center; border-top: 1px solid var(--border-color); padding-top: 15px; }
.location-box h3 { font-family: 'Amiri', serif; font-size: 1.2rem; margin: 0; color: var(--gold); }
.location-box p { font-size: 0.9rem; color: var(--text-muted); margin-top: 5px; }

/* === الشريط السفلي (الآيات والأحاديث والأذكار) === */
.footer {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 10px;
  background: rgba(11, 42, 32, 0.85);
  backdrop-filter: blur(5px);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 10px;
}
.footer-item {
  display: flex;
  align-items: center;
  text-align: center;
  padding: 0 15px;
  border-left: 1px solid #163a2d;
}
.footer-item:last-child { border-left: none; }
.footer-item .icon { font-size: 2.5rem; margin-left: 15px; }
.footer-item .content { flex: 1; display: flex; flex-direction: column; align-items: center; position: relative; min-height: 60px; }
.footer-item .content .text { 
  font-family: 'Amiri', serif; 
  font-size: 1.5rem; 
  line-height: 1.6; 
  font-weight: bold; 
  transition: opacity 0.8s ease-in-out, transform 0.8s ease-in-out;
}
.footer-item .content .source { font-size: 0.9rem; color: var(--text-muted); margin-top: 5px; }

/* === إعدادات إضافية === */
.settings-btn {
  position: absolute; bottom: 10px; right: 10px;
  background: rgba(0,0,0,0.5); border: 1px solid var(--gold);
  color: white; padding: 10px; border-radius: 50%; cursor: pointer;
  z-index: 99; transition: 0.3s;
}
.settings-btn:hover { background: var(--gold); color: black; transform: rotate(90deg); }

.overlay {
  position: fixed; inset: 0; z-index: 100;
  background: rgba(0,0,0,0.9);
  display: flex; justify-content: center; align-items: center;
  backdrop-filter: blur(5px);
  animation: fadeIn 0.3s ease;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.overlay.hidden { display: none; }
.dialog {
  background: #0f2c21; border: 2px solid var(--gold);
  border-radius: 20px; padding: 30px; max-width: 600px; width: 90%;
  color: white; text-align: center; transform: scale(0.9); animation: zoomIn 0.3s forwards;
}
@keyframes zoomIn { to { transform: scale(1); } }
.dialog h2 { color: var(--gold); font-family: 'Amiri', serif; }
.btn { background: var(--gold); border: none; padding: 10px 25px; border-radius: 30px; font-weight: bold; cursor: pointer; margin: 5px; transition: 0.2s; }
.btn:hover { opacity: 0.9; transform: translateY(-2px); }

.adhan-screen {
  position: fixed; inset: 0; z-index: 90;
  background: radial-gradient(circle, rgba(15, 44, 33, 0.95), rgba(0, 0, 0, 0.98));
  display: none; justify-content: center; align-items: center; text-align: center;
}
.adhan-screen.show { display: flex; animation: fadeIn 0.5s ease; }
.adhan-screen h2 { font-size: 4rem; color: var(--gold); text-shadow: 0 0 30px rgba(226, 188, 99, 0.5); }
.adhan-screen p { font-size: 2rem; }

@media(max-width: 1200px) {
  .app { grid-template-columns: 1fr; grid-template-rows: auto; overflow-y: auto; height: 100vh; }
  .col-left, .col-center, .col-right, .footer { grid-column: 1; }
  .footer { grid-template-columns: 1fr; }
  .footer-item { border-left: none; border-bottom: 1px solid #163a2d; padding: 10px 0; }
  .prayers-grid { grid-template-columns: repeat(3, 1fr); }
  .header { flex-direction: column; gap: 10px; padding: 15px; }
  .header-center { display: none; }
}
</style>
</head>
<body>

<!-- خلفية الصور الإسلامية المتحركة -->
<div class="slideshow-bg"></div>
<div class="overlay-layer"></div>

<div class="app">
  <header class="header">
    <div class="header-left">
      <span class="icon">🕌</span>
      <div>
        <h1 id="mosqueName">جامع الرحمن</h1>
        <span class="subtitle">الراسقية - مركز قضاء البصرة</span>
      </div>
    </div>
    <div class="header-center">
      <div class="hijri" id="hijriDate">جاري التحميل...</div>
      <div class="greg" id="gregDate">جاري التحميل...</div>
    </div>
    <div class="header-right" id="clock">00:00:00</div>
  </header>

  <aside class="col-left">
    <div class="panel clock-box">
      <div style="font-size:1rem; color:var(--text-muted); margin-bottom:15px;">الساعة الآن</div>
      <div class="analog">
        <div class="hand hand-hour" id="hourHand"></div>
        <div class="hand hand-minute" id="minuteHand"></div>
        <div class="hand hand-second" id="secondHand"></div>
        <div class="center-dot"></div>
      </div>
      <div class="sun-times">
        <div>🌅 الشروق <span id="sunriseTime">--:--</span></div>
        <div>🌇 الغروب <span id="sunsetTime">--:--</span></div>
      </div>
    </div>
  </aside>

  <section class="col-center">
    <div style="text-align:center; font-size:1.4rem; color:var(--gold); font-weight:bold;">مواقيت الصلاة لهذا اليوم</div>
    <div class="prayers-grid" id="prayersGrid"></div>
    <div class="countdown-box">
      <div class="left">
        <div class="icon">⏳</div>
        <div class="text">
          <span>الصلاة القادمة</span>
          <span id="nextPrayerName">--</span>
        </div>
      </div>
      <div class="timer" id="countdownTimer">00:00:00</div>
    </div>
  </section>

  <aside class="col-right">
    <div class="panel weather-box">
      <div class="title">🌤️ حالة الطقس</div>
      <div class="main">
        <div>
          <div class="temp" id="weatherTemp">--°</div>
          <div class="desc" id="weatherDesc">جاري التحديث</div>
        </div>
        <div class="icon" id="weatherIcon">☀️</div>
      </div>
      <div class="weather-stats">
        <div class="stat"><span>💧 الرطوبة</span><b id="humidity">--%</b></div>
        <div class="stat"><span>💨 الرياح</span><b id="wind">-- كم/س</b></div>
        <div class="stat"><span>🌡️ العظمى</span><b id="maxTemp">--°</b></div>
        <div class="stat"><span>🌡️ الصغرى</span><b id="minTemp">--°</b></div>
      </div>
    </div>
    <div class="panel location-box">
      <h3>جامع الرحمن</h3>
      <p id="placeName">جاري تحديد الموقع...</p>
    </div>
  </aside>

  <footer class="footer">
    <div class="footer-item">
      <div class="icon">📖</div>
      <div class="content">
        <div class="text" id="quranText">﴿ إِنَّ الصَّلَاةَ كَانَتْ عَلَى الْمُؤْمِنِينَ كِتَابًا مَوْقُوتًا ﴾</div>
        <div class="source" id="quranSource">سورة النساء - الآية 103</div>
      </div>
    </div>
    <div class="footer-item">
      <div class="icon">🕌</div>
      <div class="content">
        <div class="text" id="hadithText">أحب الأعمال إلى الله الصلاة على وقتها</div>
        <div class="source" id="hadithSource">رواه مسلم</div>
      </div>
    </div>
    <div class="footer-item">
      <div class="icon">☪️</div>
      <div class="content">
        <div class="text" id="dhikrText">أستغفر الله العظيم الذي لا إله إلا هو الحي القيوم وأتوب إليه</div>
        <div class="source" id="dhikrSource">100 مرة</div>
      </div>
    </div>
  </footer>
</div>

<button class="settings-btn" id="settingsBtn">⚙</button>

<div class="overlay hidden" id="settingsOverlay">
  <div class="dialog">
    <h2>إعدادات شاشة الجامع</h2>
    <div style="text-align:right; display:grid; gap:10px;">
      <div><label>اسم الجامع</label><input id="mosqueInput" value="جامع الرحمن" style="width:100%; padding:8px; border-radius:8px; border:1px solid #555; background:#1a3b2f; color:white;"></div>
      <div><label>المدينة (للبحث التلقائي)</label><input id="cityInput" value="البصرة" style="width:100%; padding:8px; border-radius:8px; border:1px solid #555; background:#1a3b2f; color:white;"></div>
      <div><label>طريقة الحساب</label>
        <select id="methodInput" style="width:100%; padding:8px; border-radius:8px; border:1px solid #555; background:#1a3b2f; color:white;">
          <option value="4">أم القرى</option>
          <option value="3">رابطة العالم الإسلامي</option>
          <option value="5">الهيئة المصرية</option>
        </select>
      </div>
    </div>
    <div style="margin-top:20px;">
      <button class="btn" id="saveBtn">حفظ وتحديث</button>
      <button class="btn" style="background:#555; color:white;" id="closeSettings">إغلاق</button>
    </div>
  </div>
</div>

<div class="adhan-screen" id="adhanScreen">
  <div>
    <div style="font-size:6rem;">🕌</div>
    <h2 id="adhanTitle">حان وقت الصلاة</h2>
    <p id="adhanSub">حي على الصلاة • حي على الفلاح</p>
  </div>
</div>
<audio id="adhanAudio" preload="auto"></audio>

<script>
const $ = id => document.getElementById(id);
const prayerDefs = [
  ['Fajr', 'الفجر', '🌙', 'ص'],
  ['Sunrise', 'الشروق', '🌅', 'ص'],
  ['Dhuhr', 'الظهر', '☀️', 'م'],
  ['Asr', 'العصر', '🌤️', 'م'],
  ['Maghrib', 'المغرب', '🌇', 'م'],
  ['Isha', 'العشاء', '🌌', 'م']
];

let state = { lat: 30.5085, lon: 47.7804, place: 'البصرة', timings: null };

const gregWeekdaysAr = { 'Sunday': 'الأحد', 'Monday': 'الإثنين', 'Tuesday': 'الثلاثاء', 'Wednesday': 'الأربعاء', 'Thursday': 'الخميس', 'Friday': 'الجمعة', 'Saturday': 'السبت' };
const gregMonthsAr = { '1': 'يناير', '2': 'فبراير', '3': 'مارس', '4': 'أبريل', '5': 'مايو', '6': 'يونيو', '7': 'يوليو', '8': 'أغسطس', '9': 'سبتمبر', '10': 'أكتوبر', '11': 'نوفمبر', '12': 'ديسمبر' };

function fmt12(t) {
  if (!t) return '--:--';
  let [h, m] = t.split(':').map(Number);
  const p = h >= 12 ? 'م' : 'ص';
  h = h % 12 || 12;
  return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')} ${p}`;
}

async function fetchPrayers() {
  const method = $('methodInput').value;
  try {
    const res = await fetch(`https://api.aladhan.com/v1/timings?latitude=${state.lat}&longitude=${state.lon}&method=${method}&school=0`);
    const data = await res.json();
    state.timings = data.data.timings;
    
    const hd = data.data.date.hijri;
    const gd = data.data.date.gregorian;
    
    $('hijriDate').textContent = `${hd.day} ${hd.month.ar} ${hd.year} هـ`;

    const gDay = gd.day;
    const gMonthNum = parseInt(gd.month.number, 10);
    const gYear = gd.year;
    const gWeekdayEn = gd.weekday.en || 'Unknown';
    const gWeekdayAr = gregWeekdaysAr[gWeekdayEn] || gWeekdayEn;
    const gMonthAr = gregMonthsAr[gMonthNum] || gd.month.en || 'Unknown';

    $('gregDate').textContent = `${gWeekdayAr} ${gDay} ${gMonthAr} ${gYear}م`;

    const grid = $('prayersGrid');
    grid.innerHTML = prayerDefs.map(([k, n, i, p]) => `
      <div class="prayer-item" id="p-${k}">
        <div class="icon">${i}</div>
        <div class="name">${n}</div>
        <div class="time">${fmt12(state.timings[k])}</div>
        <div class="period">${p}</div>
      </div>
    `).join('');

    $('sunriseTime').textContent = fmt12(state.timings.Sunrise);
    $('sunsetTime').textContent = fmt12(state.timings.Maghrib);

  } catch (e) { console.error("API Error:", e); }
}

async function fetchWeather() {
  try {
    const res = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${state.lat}&longitude=${state.lon}&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m&daily=temperature_2m_max,temperature_2m_min&timezone=auto`);
    const data = await res.json();
    const c = data.current;
    $('weatherTemp').textContent = Math.round(c.temperature_2m) + '°';
    $('humidity').textContent = c.relative_humidity_2m + '%';
    $('wind').textContent = Math.round(c.wind_speed_10m) + ' كم/س';
    $('maxTemp').textContent = Math.round(data.daily.temperature_2m_max[0]) + '°';
    $('minTemp').textContent = Math.round(data.daily.temperature_2m_min[0]) + '°';
    
    const codes = { 0: ['☀️', 'صحو'], 1: ['🌤️', 'غائم جزئياً'], 3: ['☁️', 'غائم'] };
    const w = codes[c.weather_code] || ['🌤️', 'معتدل'];
    $('weatherIcon').textContent = w[0];
    $('weatherDesc').textContent = w[1];
  } catch (e) { console.error("Weather Error"); }
}

function updateTimers() {
  const now = new Date();
  const h = now.getHours(), m = now.getMinutes(), s = now.getSeconds();
  
  // Clock
  $('clock').textContent = `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;

  const degH = (h % 12) * 30 + m * 0.5 + s * (0.5/60);
  const degM = m * 6 + s * 0.1;
  const degS = s * 6;
  $('hourHand').style.transform = `rotate(${degH}deg)`;
  $('minuteHand').style.transform = `rotate(${degM}deg)`;
  $('secondHand').style.transform = `rotate(${degS}deg)`;

  if (!state.timings) return;
  const nowMins = h * 60 + m + s / 60;
  let next = null;
  for (const [k] of prayerDefs) {
    if (k === 'Sunrise') continue;
    const t = state.timings[k].split(':');
    const pMins = +t[0] * 60 + +t[1];
    if (pMins > nowMins) { next = { name: prayerDefs.find(x=>x[0]===k)[1], time: pMins }; break; }
  }
  if (!next) {
    const t = state.timings.Fajr.split(':');
    next = { name: 'الفجر', time: (+t[0] * 60 + +t[1]) + 1440 };
  }

  const diffSecs = Math.max(0, Math.round((next.time - nowMins) * 60));
  const hrs = Math.floor(diffSecs / 3600);
  const mins = Math.floor((diffSecs % 3600) / 60);
  const secs = diffSecs % 60;
  $('countdownTimer').textContent = `${String(hrs).padStart(2,'0')}:${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}`;
  $('nextPrayerName').textContent = next.name;

  document.querySelectorAll('.prayer-item').forEach(el => el.classList.remove('active'));
  const currPrayer = prayerDefs.filter(([k])=> k!=='Sunrise').reverse().find(([k])=> {
    const t = state.timings[k].split(':');
    return (+t[0]*60 + +t[1]) <= nowMins;
  });
  if (currPrayer) $(`p-${currPrayer[0]}`).classList.add('active');
}


